<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<!--        Use the MainWindow Java class to control this FXML window-->
<AnchorPane prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="benji.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="45.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="10.0"/>
            </content>
        </ScrollPane>

        <TextField fx:id="userInput"
                   promptText="Type a command here..."
                   onAction="#handleUserInput"
                   AnchorPane.leftAnchor="5.0"
                   AnchorPane.rightAnchor="80.0"
                   AnchorPane.bottomAnchor="5.0"/>

        <Button text="Send"
                onAction="#handleUserInput"
                prefWidth="70.0"
                AnchorPane.rightAnchor="5.0"
                AnchorPane.bottomAnchor="5.0"/>
    </children>
</AnchorPane>